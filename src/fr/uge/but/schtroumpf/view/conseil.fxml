<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="conseilSection" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="900.0">
         <children>
            <Label styleClass="title_gameplay" text="Conseil" />
            <Label styleClass="sub_title_gameplay" text="Sélectionner un Schtroumpf" />
         </children>
      </VBox>

      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>

            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="15.0">
               <children>
                  <VBox id="gourmand" fx:id="cardGourmand" alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" onMouseClicked="#smurfCardSelected" styleClass="smurf_card_on" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/schtroumpf_gourmand.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>

                  <VBox id="grognon" fx:id="cardGrognon" alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" onMouseClicked="#smurfCardSelected" styleClass="smurf_card_off" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/schtroumpf_grognon.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>

                  <VBox id="schtroumpfette" fx:id="cardSchtroumpfette" alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" onMouseClicked="#smurfCardSelected" styleClass="smurf_card_off" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/schtroumpfette.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>
               </children>
            </VBox>

            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="327.0" spacing="15.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" styleClass="section_gameplay">
                     <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="title2_gameplay" text="Schtroumpf Gourmand" VBox.vgrow="ALWAYS" />

                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label styleClass="title3_gameplay" text="Actions possibles :">
                                 <VBox.margin>
                                    <Insets bottom="5.0" />
                                 </VBox.margin>
                              </Label>

                              <Label style="-fx-font-size: 11;" text="Organiser un festin (-1 Baies, +2 Moral)" />
                              <Label style="-fx-font-size: 11;" text="Cueillir des baies (+1 Baies)" />
                              <Label style="-fx-font-size: 11;" text="Trouver un champignon rare (bonus aléatoire)" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#selectSmurfAction" style="-fx-border-radius: 10;" styleClass="btn_princip_gameplay" text="Utiliser" VBox.vgrow="ALWAYS">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </VBox>

            <VBox alignment="CENTER" layoutX="176.0" layoutY="10.0" maxWidth="1.7976931348623157E308" spacing="15.0">
               <children>
                  <VBox id="bricoleur" fx:id="cardBricoleur" alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" onMouseClicked="#smurfCardSelected" styleClass="smurf_card_off" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/schtroumpf_bricoleur.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>

                  <VBox id="grand_schtroumpf" fx:id="cardGrandSchtroumpf" alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" onMouseClicked="#smurfCardSelected" styleClass="smurf_card_off" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/grand_schtroumpf.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>

                  <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" styleClass="pay_to_win_smurf_card" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                           <image>
                              <Image url="@ressource/pay_to_win_schtroumpf.png" />
                           </image>
                        </ImageView>
                     </children>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </VBox>
               </children>
            </VBox>

         </children>
      </HBox>
   </children>
</VBox>
