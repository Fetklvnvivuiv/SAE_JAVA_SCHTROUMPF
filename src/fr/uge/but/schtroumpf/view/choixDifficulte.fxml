<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="30.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.uge.but.schtroumpf.controller.ChoixDifficulteController">
   <children>
      <Label alignment="CENTER" prefWidth="9999.0" styleClass="title_gameplay" text="Nouvelle partie" />
      <HBox fx:id="difficultyContainer" alignment="CENTER" spacing="30.0">
         <children>
            <VBox id="facile" alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" onMouseClicked="#cardSelected" spacing="20.0" styleClass="difficulty_card_off" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                     <children>
                        <ImageView fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@ressource/niveau-facile.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="title_gameplay" text="FACILE" />
                     </children>
                  </VBox>
                  <Label style="-fx-font-size: 15;" styleClass="texte-carte" text="• 3 ressources produites à&#10;chaque début de tour&#10;&#10;• 33% d’avoir un&#10;événement négatif" wrapText="true" />
               </children>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </VBox>
            <VBox id="moyen" alignment="TOP_CENTER" onMouseClicked="#cardSelected" spacing="20.0" styleClass="difficulty_card_off" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                     <children>
                        <ImageView fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@ressource/niveau-moyen.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="title_gameplay" text="MOYEN" />
                     </children>
                  </VBox>
                  <Label style="-fx-font-size: 15;" styleClass="texte-carte" text="• 2 ressources produites à&#10;chaque début de tour&#10;&#10;• 50% d’avoir un&#10;événement négatif&#10;&#10;• 3 crises avant le défaite" wrapText="true" />
               </children>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </VBox>
            <VBox id="difficile" alignment="TOP_CENTER" onMouseClicked="#cardSelected" spacing="20.0" styleClass="difficulty_card_off" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                     <children>
                        <ImageView fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@ressource/niveau-difficile.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="title_gameplay" text="DIFFICILE" />
                     </children>
                  </VBox>
                  <Label style="-fx-font-size: 15;" styleClass="texte-carte" text="• 1 ressource produite à&#10;chaque début de tour&#10;&#10;• 75% d’avoir un&#10;événement négatif&#10;&#10;• 1 crise avant le défaite" wrapText="true" />
               </children>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#retourMenu" styleClass="btn_second_difficulty" text="Retour">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <VBox prefWidth="100.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#validerChoix" styleClass="btn_princip_difficulty" text="Jouer">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="60.0" right="60.0" top="10.0" />
   </padding>
</VBox>
