<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="500.0" minHeight="-Infinity" minWidth="-Infinity" prefWidth="500.0" spacing="30.0" style="-fx-background-color: white;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onAction="#afficherConseil" styleClass="btn_second_gameplay" text="Retour">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="title2_gameplay" text="Sélectionner une action " HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#smurfActionResult" styleClass="btn_princip_gameplay_colored" text="Utiliser">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="30.0">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" spacing="10.0" styleClass="section_gameplay">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@ressource/grand_schtroumpf.png" />
                     </image>
                  </ImageView>
                  <Label text="Grand Schtroumpf" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefHeight="200.0" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label id="c1" fx:id="c1" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#choiceSelected" styleClass="smurf_card_off" text="Cueillir des baies (+1 Baies)" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <Label id="c2" fx:id="c2" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#choiceSelected" styleClass="smurf_card_off" text="Cueillir des baies (+1 Baies)" VBox.vgrow="ALWAYS" />
                  <Label id="c3" fx:id="c3" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#choiceSelected" styleClass="smurf_card_off" text="Cueillir des baies (+1 Baies)" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
