<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.uge.but.schtroumpf.controller.VictoryController">

   <children>

      <VBox alignment="CENTER"
            spacing="18.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="55.0">

         <children>

            <Label styleClass="victory-title"
                   text="VICTOIRE !" />

            <Label styleClass="victory-subtitle"
                   text="Le village des Schtroumpfs a survécu pendant 12 mois" />

         </children>

      </VBox>

      <HBox alignment="CENTER"
            spacing="130.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="230.0">

         <children>

            <VBox alignment="CENTER"
                  spacing="10.0">

               <children>

                  <Label fx:id="scoreLabel"
                         styleClass="stat-number"
                         text="1250" />

                  <Label styleClass="stat-label"
                         text="Score final" />

               </children>

            </VBox>

            <VBox alignment="CENTER"
                  spacing="10.0">

               <children>

                  <Label fx:id="tourLabel"
                         styleClass="stat-number"
                         text="12/12" />

                  <Label styleClass="stat-label"
                         text="Tours suivants" />

               </children>

            </VBox>

            <VBox alignment="CENTER"
                  spacing="10.0">

               <children>

                  <Label fx:id="criseLabel"
                         styleClass="stat-number"
                         text="4" />

                  <Label styleClass="stat-label"
                         text="Crises évitées" />

               </children>

            </VBox>

            <VBox alignment="CENTER"
                  spacing="10.0">

               <children>

                  <Label fx:id="ressourceLabel"
                         styleClass="stat-number"
                         text="23" />

                  <Label styleClass="stat-label"
                         text="Ressources restantes" />

               </children>

            </VBox>

         </children>

      </HBox>

      <HBox alignment="TOP_CENTER"
            spacing="55.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="380.0">

         <children>

            <VBox alignment="TOP_CENTER"
                  prefWidth="320.0"
                  spacing="28.0">

               <children>

                  <Label styleClass="section-title"
                         text="Ressource consommées" />

                  <VBox fx:id="ressourceContainer"
                        spacing="22.0" />

               </children>

            </VBox>

            <Region prefWidth="1.5"
                    prefHeight="250.0"
                    styleClass="separator-line" />

            <VBox alignment="TOP_CENTER"
                  prefWidth="320.0"
                  spacing="28.0">

               <children>

                  <Label styleClass="section-title"
                         text="Événements rencontrés" />

                  <VBox fx:id="eventContainer"
                        spacing="22.0" />

               </children>

            </VBox>

            <Region prefWidth="1.5"
                    prefHeight="250.0"
                    styleClass="separator-line" />

            <VBox alignment="TOP_CENTER"
                  prefWidth="320.0"
                  spacing="28.0">

               <children>

                  <Label styleClass="section-title"
                         text="Schtroumpf utilisés" />

                  <VBox fx:id="schtroumpfContainer"
                        spacing="22.0" />

               </children>

            </VBox>

         </children>

      </HBox>

      <HBox alignment="CENTER"
            spacing="25.0"
            AnchorPane.bottomAnchor="45.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <children>

            <Button mnemonicParsing="false"
                    prefHeight="58.0"
                    prefWidth="190.0"
                    styleClass="bouton-noir"
                    text="Menu principal" 
                    onAction="#retourMenu"/>

            <Button mnemonicParsing="false"
                    prefHeight="58.0"
                    prefWidth="190.0"
                    styleClass="bouton-bleu"
                    text="Rejouer" />

         </children>

      </HBox>

   </children>
   <styleClass>
   		<String fx:value="background-victoire" />
   </styleClass>

</AnchorPane>